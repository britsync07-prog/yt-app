# Copy to .env (local) or set the same names in the Render dashboard.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste-a-long-random-string-here
ACCESS_KEY=paste-your-owner-access-key-here
FRONTEND_URL=https://your-site.pages.dev
JWT_EXPIRE_MINUTES=10080
# Optional anti-bot cookies (paste the CONTENTS of a cookies.txt export
# for youtube.com, or set YT_COOKIES_FILE to a file path instead).
# YT_COOKIES=
# YT_COOKIES_FILE=
# Optional Cloudflare relay (cf-worker.js): used automatically when
# yt-dlp is bot-checked. Set both or neither.
# WORKER_URL=https://your-relay.<you>.workers.dev
# WORKER_KEY=
